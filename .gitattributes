# Normalise all text files to LF in the repo, checkout as-is on Windows
* text=auto
*.py   text eol=lf
*.md   text eol=lf
*.toml text eol=lf
*.txt  text eol=lf
*.jsonl text eol=lf
*.csv  text eol=lf

# Binary index files are NOT stored in git (rebuilt at Docker build time)
# See scripts/build_index_from_jsonl.py
