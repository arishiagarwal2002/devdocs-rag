# Normalise all text files to LF in the repo, checkout as-is on Windows
* text=auto
*.py   text eol=lf
*.md   text eol=lf
*.toml text eol=lf
*.txt  text eol=lf
*.jsonl text eol=lf
*.csv  text eol=lf

# Binary files — stored in Git LFS
*.index filter=lfs diff=lfs merge=lfs -text
*.pkl   filter=lfs diff=lfs merge=lfs -text
