# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/

# ── Environments ──────────────────────────────────────────────────────────────
.env
.env.*
.venv/
venv/
env/

# ── Secrets ───────────────────────────────────────────────────────────────────
.streamlit/secrets.toml   # never commit API keys

# ── Raw scraped docs (re-downloadable via `python -m src.ingest`) ─────────────
data/raw/

# Binary index files are rebuilt at Docker build time from chunks.jsonl
# (HF Spaces blocks binary blobs in git pushes)
data/index/faiss.index
data/index/chunks.pkl

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editors ───────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── Logs / temp ───────────────────────────────────────────────────────────────
*.log
*.tmp
